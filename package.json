{
  "name": "ruby-fy-bot",
  "version": "1.0.0",
  "description": "Bot Discord Ruby-FY",
  "type": "module",
  "main": "src/index.mjs",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.mjs",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.mjs",
    "test": "node --disable-warning=ExperimentalWarning -r dotenv/config --test --test-concurrency=1 tests/*.mjs",
    "test:watch": "node --disable-warning=ExperimentalWarning -r dotenv/config --watch --test --test-concurrency=1 tests/*.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "node-fetch": "^3.3.2"
  }
}
