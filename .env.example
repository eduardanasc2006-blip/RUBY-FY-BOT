# ── Credenciais do bot (obrigatório) ──────────────────────────────────────────
# Token do bot — discord.com/developers/applications → seu bot → Token
DISCORD_TOKEN=

# ID da aplicação do bot (aba "General Information")
CLIENT_ID=

# ── Ambiente de desenvolvimento ────────────────────────────────────────────────
# ID do servidor de testes para deploy instantâneo de slash commands.
# Deixe vazio para deploy global (pode demorar até 1h para propagar).
GUILD_ID=

# ── Permissões ─────────────────────────────────────────────────────────────────
# IDs dos donos do bot, separados por vírgula (sem espaços).
# Ex: OWNER_IDS=123456789012345678,987654321098765432
OWNER_IDS=

# ── Banco de dados ─────────────────────────────────────────────────────────────
# Caminho do arquivo SQLite. A pasta é criada automaticamente.
# Padrão: ./data/ruby-fy.db
DATABASE_PATH=
