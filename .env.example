# ── Credenciais do bot (obrigatório) ──────────────────────────────────────────
# Token do bot — discord.com/developers/applications → seu bot → Token
DISCORD_TOKEN=

# ID da aplicação do bot (aba "General Information")
CLIENT_ID=

# ── Ambiente de desenvolvimento ────────────────────────────────────────────────
# ID do servidor de testes para deploy instantâneo de slash commands.
# Deixe vazio para deploy global (pode demorar até 1h para propagar).
GUILD_ID=

# ── Permissões ─────────────────────────────────────────────────────────────────
# IDs dos donos do bot, separados por vírgula (sem espaços).
# Ex: OWNER_IDS=123456789012345678,987654321098765432
OWNER_IDS=

# ── Banco de dados ─────────────────────────────────────────────────────────────
# Caminho do arquivo SQLite. A pasta é criada automaticamente.
# Padrão: ./data/ruby-fy.db
DATABASE_PATH=

# ── Servidor Web (Etapa 19A) ───────────────────────────────────────────────────
# Porta onde o servidor web Express escutará.
# Padrão: 3000
WEB_PORT=3000

# URL pública base do servidor web (sem barra final).
# Usada para construir o callback OAuth2.
# Ex: https://dashboard.rubyfy.com
WEB_BASE_URL=http://localhost:3000

# URL do frontend para redirects após login/logout.
# Pode ser diferente de WEB_BASE_URL em setups com frontend separado.
WEB_FRONTEND_URL=http://localhost:3000

# ── Discord OAuth2 (Etapa 19A) ─────────────────────────────────────────────────
# Client ID da aplicação Discord (mesmo valor de CLIENT_ID, ou separado).
DISCORD_CLIENT_ID=

# Client Secret da aplicação Discord
# Nunca commite este valor — mantenha apenas no .env local ou em secrets.
DISCORD_CLIENT_SECRET=

# URL de callback OAuth2 registrada no portal Discord.
# Deve corresponder exatamente ao que está cadastrado em:
#   discord.com/developers/applications → OAuth2 → Redirects
# Padrão: WEB_BASE_URL/auth/callback
DISCORD_CALLBACK_URL=http://localhost:3000/auth/callback

# ── Sessões (Etapa 19A) ───────────────────────────────────────────────────────
# Secret para assinar cookies de sessão.
# Gere um valor aleatório forte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-isso-por-um-valor-secreto-forte

# Duração das sessões em segundos. Padrão: 604800 (7 dias).
SESSION_TTL_SECONDS=604800

# ── CORS (Etapa 19A) ─────────────────────────────────────────────────────────
# Origens permitidas para CORS, separadas por vírgula.
# Padrão: WEB_BASE_URL
CORS_ORIGINS=http://localhost:3000

# ── Ambiente ───────────────────────────────────────────────────────────────────
# 'development' ou 'production'
NODE_ENV=development
